# Clave del cliente: restringida por referrer, solo Maps JavaScript API.
# Es publica por naturaleza (viaja en el navegador).
VITE_MAPS_KEY=

# Driver del panorama: js (Maps JavaScript API) | embed (iframe gratis e ilimitado)
VITE_PANO_DRIVER=js

# Clave del baker: sin restriccion de referrer, solo Street View Static API.
# Nunca se commitea. Las llamadas a metadata son gratis y no consumen cuota.
GOOGLE_MAPS_BAKE_KEY=
